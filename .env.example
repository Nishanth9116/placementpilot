# PlacementPilot Environment Configuration
# Copy this file to .env for local overrides

# Local SQLite Database Path (Local-first, no cloud databases)
DATABASE_PATH=./data/placementpilot.db

# MCP Server Configuration
MCP_SERVER_NAME=PlacementPilot
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=stdio

# Application Logging
LOG_LEVEL=INFO

